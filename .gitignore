# raw export and its unzipped form: inputs, not sources.
# Leading slash anchors these to the repository root: a bare `data/` would also
# match `web/data/`, which is the data the viewer serves and must be tracked.
/assets/
/data/

# web/data/ used to be ignored here. It is tracked now: the published viewer
# reads it from the same directory, and GitHub Pages can only serve what is in
# the repository. `tools/build.mjs` still wipes and rebuilds it every run, so a
# rebuild shows up as a normal diff of generated files.

# LLM output that cannot be recomputed is kept, but it is not part of the site.
# (web/data/refine/ and web/data/qdigest/ are pipeline inputs; the deploy job
# strips them from the published artifact.)

# OS noise
.DS_Store
